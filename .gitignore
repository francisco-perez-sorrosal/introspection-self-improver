# Generated Pi runtime state. mcp-catalogs/ holds one file per MCP endpoint, and the bridge
# binds a fresh ephemeral port every episode, so it accumulates a file per run.
.pi/bin/
.pi/mcp-catalogs/
.pi/mcp-session.json
.pi/mcporter.json

# Diagnostic-mode workspace. A throwaway copy of the Recipe with a non-locked domain's
# policy substituted, built per run by benchmark/tau_adapter/run.py. It lives inside the work
# tree, not /tmp, because `introspection local` validates the Recipe and that validation reads
# gitignore — see _materialise_workspace.
/.diagnostic-workspace/

# Local capability bindings — endpoints and credentials never belong in the repo
.pi/mcp.local.json

# τ²-bench checkout. Pinned by benchmark/benchmark_lock.yaml and reproduced by
# `make bootstrap`. Deliberately untracked: the evaluator is not ours to modify,
# and keeping it out of our history makes that structural rather than procedural.
benchmark/vendor/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# Environment
.env
.env.local

# Local Claude Code settings
.claude/settings.local.json
.claude/praxion-rules.yaml.example

# Session-telemetry WAL (machine-local, never project record)
.ai-state/observations.jsonl
.ai-state/observations.lock

# tau2 rebuilds the document embedding cache on demand and invalidates it when document
# content changes; it is a 17 MB derived artifact keyed by content hash, not a source of
# truth. openai_embeddings retrieval writes it here on first use (Phase 0, plan D36).
benchmark/data/.embeddings_cache/
